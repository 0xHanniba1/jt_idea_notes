# JT Idea Notes password authentication: see docs/admin-password-login-operations.md.
# These HTTP settings are for local development only. Production requires
# GO_ENV=production and BASE_URL=https://your-site.example (including its port).
BASE_URL=http://localhost:3000
GO_ENV=development
DATABASE_URL=postgres://fider:fider_pw@localhost:5555/fider?sslmode=disable
# Set a unique private signing secret before running, including local development.
# Never reuse a shared example value or commit the populated environment file.
JWT_SECRET=
# Forwarded headers are ignored by default. Set only the actual, network-restricted
# reverse-proxy peer CIDRs, comma-separated; never trust 0.0.0.0/0 or ::/0.
# A loopback proxy example is 127.0.0.1/32,::1/128; use it only if it is your proxy.
TRUSTED_PROXY_CIDRS=
# Run one authentication/application process: login rate limits are process-local.
# Do not enable multiple replicas without adding shared rate-limit storage.
# Leave CDN_HOST unset unless protected attachments remain on the authenticated
# origin; /static/images and avatar URLs must not use a public CDN or public bucket.
# ALLOW_ALLOWED_SCHEMES=false
# Relaxes the SSRF guard so webhooks and OAuth token/profile URLs may target
# private/internal network addresses (LAN, loopback, link-local). Self-hosted only.
# ALLOW_PRIVATE_NETWORK_TARGETS=true

LOG_LEVEL=DEBUG
LOG_CONSOLE=true
LOG_SQL=true
LOG_FILE=false
LOG_FILE_OUTPUT=logs/output.log

# MAINTENANCE=true
# MAINTENANCE_MESSAGE=Sorry, we're down for scheduled maintenance right now.
# MAINTENANCE_UNTIL=about 5 AM PDT

# Legacy OAuth settings are retained for upstream compatibility only. They cannot
# enable OAuth, email login, public signup, API keys, or identity impersonation.
OAUTH_FACEBOOK_APPID=
OAUTH_FACEBOOK_SECRET=

OAUTH_GOOGLE_CLIENTID=
OAUTH_GOOGLE_SECRET=

OAUTH_GITHUB_CLIENTID=
OAUTH_GITHUB_SECRET=
